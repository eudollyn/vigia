# ============================================================
#  VIGIA · configuração
#  O instalador copia este arquivo para ".env". Preencha o .env
#  (ele fica só no seu PC e NUNCA vai para o GitHub).
# ============================================================

# ---------- E-mail (IMAP) ----------
# Deixe EMAIL_USUARIO vazio para desligar o leitor de e-mail.
EMAIL_USUARIO=
EMAIL_SENHA=
# Servidor IMAP do seu provedor (padrão: Locaweb). Ex.: imap.gmail.com, outlook.office365.com
IMAP_HOST=email-ssl.com.br
IMAP_PORTA=993

# ---------- WhatsApp ----------
# 1 = ligado (na primeira vez aparece um QR code para escanear), 0 = desligado
WHATSAPP=1

# ---------- Inteligência (Google Gemini, tem nível gratuito) ----------
# Crie a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Quem resume as mensagens: gemini, claude ou simples (sem IA)
RESUMO_IA=gemini
GEMINI_MODELO=gemini-flash-lite-latest

# ---------- Voz ----------
VOZ=1
# microsoft (vozes neurais do Edge, grátis) | google (Gemini TTS, cota pequena) | windows
VOZ_MOTOR=microsoft
# pt-BR-FranciscaNeural, pt-BR-ThalitaMultilingualNeural, pt-BR-AntonioNeural
VOZ_MICROSOFT=pt-BR-FranciscaNeural
# Horário sem voz (só notificação). Ex.: 22-7. Vazio = sempre fala.
SILENCIO=22-7
# Como a saudação te chama. Ex.: Sr. João → "Bom dia, Sr. João!"
SAUDACAO_NOME=
# Como a voz deve FALAR certos nomes (a tela não muda). Ex.: Thalyta=Talíta;Joao=João
PRONUNCIA=

# ---------- Prioridades ----------
# Grupos/contatos que NÃO falam na hora, só entram no resumo de hora em hora (pedaço do nome, separados por vírgula)
BAIXA_PRIORIDADE=
RESUMO_BAIXA_MIN=60
# Contatos privados: a voz diz só "Mensagem de <nome>", sem ler o conteúdo
PRIVADOS=
# 1 = o aviso diz só de quem é; o conteúdo é lido quando você diz "leia". 0 = já lê tudo no aviso
LER_SOB_DEMANDA=1
# Mensagens picadas: junta as seguidas da mesma conversa até a pessoa ficar X segundos sem mandar nada
AGRUPAR_SEGUNDOS=20
# Depois de avisar alguém, não fala dessa pessoa de novo por X minutos (só tela); no fim diz "mandou mais N mensagens".
# Não vale quando você está conversando com a pessoa (mandou mensagem para ela nos últimos 10 min).
PAUSA_MESMA_PESSOA_MIN=2

# ---------- Página do Vigia (voz, microfone e comandos no navegador) ----------
# Pode ser aberta NESTE PC (http://localhost:8765/?k=...) ou em outro aparelho da rede (notebook, tablet).
# 1 = abre sozinha no navegador deste PC quando o Vigia liga. 0 = você abre em outro aparelho.
ABRIR_PAGINA=1
# notebook = a voz toca na página quando ela estiver aberta (senão no PC) | pc = sempre no PC | ambos
SAIDA_VOZ=notebook
ALTO_FALANTE_PORTA=8765
# De onde vem a sua voz: notebook = microfone da página (neste PC ou no outro aparelho) | pc = microfone do PC via ffmpeg
MICROFONE_ORIGEM=notebook
# Microfone do PC (vazio = escolhe sozinho)
MICROFONE=
RESPONDER_VOZ=1
JANELA_SEGUNDOS=7

# ---------- Previsão do tempo no bom dia ----------
CLIMA_CIDADE=São Paulo
CLIMA_LAT=-23.55
CLIMA_LON=-46.63
